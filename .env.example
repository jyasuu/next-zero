# Authentication
AUTH_PROVIDER=github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=your-secret-key-change-in-production

# Server Admin (built-in credentials login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set to false to disable the built-in admin login (OAuth only)
# ADMIN_LOGIN_ENABLED=true
# Maps realm roles to app roles; unmapped users get no grants
ROLE_MAPPING={"admin":"Admin","editor":"Editor","viewer":"Viewer","auditor":"Auditor"}

# For Keycloak (production)
# AUTH_PROVIDER=keycloak
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_ISSUER=

# NextAuth
NEXTAUTH_URL=http://localhost:3000

# Postgres (required). Local: docker compose up postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/next_zero

# AI Chat
# Set to true to enable the chat assistant
# AI_ENABLED=true
# Set to 1 to use the deterministic mock model (no network) for tests/e2e
# AI_MOCK=1
# OpenAI-compatible endpoint and model for the chat assistant
# AI_BASE_URL=https://opencode.ai/zen/v1
# AI_API_KEY=
# AI_MODEL=big-pickle
# Session title generation timeout in ms (default: 5000)
# AI_TITLE_TIMEOUT_MS=5000
